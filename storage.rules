rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Phase 2: tenant-scoped photo storage (orgs/{orgId}/competitions/{compId}/...)
    // with membership checks via cross-service firestore.get(). Locked until then —
    // the claims-based gate below died with custom claims, and the flat path
    // isn't tenant-safe. Contestants.tsx degrades gracefully (upload catch).
    match /contestants/{file=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
