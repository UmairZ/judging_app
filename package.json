{
  "name": "ubayy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "build:sandbox": "tsc && vite build --mode sandbox",
    "deploy:sandbox": "npm run build:sandbox && firebase deploy -P sandbox",
    "deploy:prod": "node scripts/confirm-prod.mjs && npm run build && firebase deploy -P prod",
    "emulators": "firebase emulators:start --only firestore,auth,functions,storage --project demo-ubayy"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tailwindplus/elements": "^1.0.22",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.22.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
