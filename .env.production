# Ubayy production — public web config (not secret; access is gated by rules + Auth)
VITE_FB_API_KEY=AIzaSyD0hOo5wYRNPBmz53v-XAmO1OSerltkzW0
# Same-site as the served app (ubayy-prod.web.app also hosts /__/auth): keeps the
# Google sign-in popup handoff first-party — cross-site (firebaseapp.com) gets its
# storage partitioned/blocked on mobile Safari and Brave, silently dropping the result.
VITE_FB_AUTH_DOMAIN=ubayy-prod.web.app
# Google sign-in hidden for the 2026 competition (OAuth redirect-URI churn on the
# auto-created client; admin uses email+password on the same account). Remove to restore.
VITE_HIDE_GOOGLE_AUTH=1
VITE_FB_PROJECT_ID=ubayy-prod
VITE_FB_STORAGE_BUCKET=ubayy-prod.firebasestorage.app
