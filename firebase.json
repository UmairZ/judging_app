{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": ["npm --prefix functions run build"]
  },
  "hosting": {
    "public": "dist",
    "predeploy": ["npm run build"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/zeffy/**", "function": { "functionId": "zeffyWebhook", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8180 },
    "auth": { "port": 9099 },
    "storage": { "port": 9199 },
    "singleProjectMode": true,
    "ui": { "enabled": true }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
